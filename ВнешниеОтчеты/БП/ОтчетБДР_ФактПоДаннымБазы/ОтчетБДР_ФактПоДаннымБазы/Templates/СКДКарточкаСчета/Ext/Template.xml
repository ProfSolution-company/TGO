		<query>ВЫБРАТЬ
	ДанныеПроектовПТО.Регистратор КАК Регистратор,
	ДанныеПроектовПТО.ДокументПоступления КАК ДокументПоступления,
	ДанныеПроектовПТО.НоменклатурнаяГруппа КАК ЭтапПроекта,
	ДанныеПроектовПТО.Сумма КАК Сумма,
	ДанныеПроектовПТО.ДокументПоступления.НомерВходящегоДокумента КАК НомерВходящегоПТиУ,
	ДанныеПроектовПТО.ДокументПоступления.ДатаВходящегоДокумента КАК ДатаВходящегоПТиУ
ИЗ
	РегистрНакопления.ДанныеПроектовПТО КАК ДанныеПроектовПТО
ГДЕ
	ДанныеПроектовПТО.НоменклатурнаяГруппа В ИЕРАРХИИ(&amp;Проект)
	И ВЫБОР
			КОГДА &amp;ВерхнийУровень
				ТОГДА ИСТИНА
			ИНАЧЕ ДанныеПроектовПТО.СтатьяЗатрат В ИЕРАРХИИ (&amp;СтатьяЗатрат)
		КОНЕЦ
	И ДанныеПроектовПТО.Период МЕЖДУ &amp;ДатаНачало И &amp;ДатаКонец
	И ДанныеПроектовПТО.Счет В ИЕРАРХИИ(&amp;Счет)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ХозрасчетныйОбороты.Регистратор,
	NULL,
	ХозрасчетныйОбороты.Субконто1,
	ХозрасчетныйОбороты.СуммаОборотДт,
	NULL,
	NULL
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Обороты(
			&amp;ДатаНачало,
			&amp;ДатаКонец,
			Авто,
			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОсновноеПроизводство_)),
			&amp;ВидыСубконто,
			,
			ВЫБОР
				КОГДА &amp;Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОсновноеПроизводство_)
					ТОГДА КорСчет &lt;&gt; ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбщепроизводственныеРасходы)
							И КорСчет &lt;&gt; ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбщехозяйственныеРасходы)
				ИНАЧЕ ВЫБОР
						КОГДА &amp;Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбщепроизводственныеРасходы)
							ТОГДА КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбщепроизводственныеРасходы)
						ИНАЧЕ ВЫБОР
								КОГДА &amp;Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбщехозяйственныеРасходы)
									ТОГДА КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбщехозяйственныеРасходы)
							КОНЕЦ
					КОНЕЦ
			КОНЕЦ,
			) КАК ХозрасчетныйОбороты
ГДЕ
	ВЫБОР
			КОГДА &amp;ВерхнийУровень
				ТОГДА ИСТИНА
			ИНАЧЕ ХозрасчетныйОбороты.Субконто2 В ИЕРАРХИИ (&amp;СтатьяЗатрат)
		КОНЕЦ
	И ХозрасчетныйОбороты.Субконто1 В ИЕРАРХИИ(&amp;Проект)
	И НЕ ХозрасчетныйОбороты.Субконто1.ЭтоГруппа
	И ТИПЗНАЧЕНИЯ(ХозрасчетныйОбороты.Регистратор) &lt;&gt; ТИП(Документ.СправкаПТО)</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
